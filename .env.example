# EmailJS — delivers contact form submissions to anis.inbox10@gmail.com
# Dashboard: https://dashboard.emailjs.com/admin
#
# 1. Email Services -> connect the Gmail account that owns anis.inbox10@gmail.com -> copy the Service ID
# 2. Email Templates -> create a template and set its "To Email" field to {{to_email}}
#    (available variables: {{to_email}} {{from_name}} {{reply_to}} {{subject}} {{message}})
#    -> copy the Template ID
# 3. Account -> General -> copy the Public Key
#
# Copy these into .env.local (which is git-ignored) and fill in the real values.
VITE_EMAILJS_SERVICE_ID=service_mlnl16o
VITE_EMAILJS_TEMPLATE_ID=template_e19hk5e
VITE_EMAILJS_PUBLIC_KEY=rTovarWJC2HfQcEt-
